# Built from the repository root so the server can import src/geometry.
FROM node:22-alpine
WORKDIR /repo/server
COPY server/package.json server/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY server/tsconfig.json ./
COPY server/migrations ./migrations
COPY server/src ./src
COPY src/geometry /repo/src/geometry
COPY src/lib /repo/src/lib
COPY src/i18n /repo/src/i18n
ENV PORT=3000
EXPOSE 3000
CMD ["npx", "tsx", "src/main.ts"]
