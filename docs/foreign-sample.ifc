ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('foreign-sample.ifc','2026-09-05T12:00:00',('Sample'),('Other tool'),'OtherTool 1.0','OtherTool','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* A minimal file in the style of another authoring tool: rectangle profiles with
   placements instead of polylines, one curved wall that Bauwerk cannot hold. */
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCCARTESIANPOINT((0.,0.,0.));
#4=IFCDIRECTION((0.,0.,1.));
#5=IFCDIRECTION((1.,0.,0.));
#6=IFCAXIS2PLACEMENT3D(#3,#4,#5);
#7=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#6,$);
#8=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#7,$,.MODEL_VIEW.,$);
#9=IFCPROJECT('0project000000000000aa',$,'Foreign project',$,$,$,$,(#7),#2);
#10=IFCLOCALPLACEMENT($,#6);
#11=IFCSITE('0site00000000000000aab',$,'Site',$,$,#10,$,$,.ELEMENT.,$,$,$,$,$);
#12=IFCLOCALPLACEMENT(#10,#6);
#13=IFCBUILDING('0building000000000aac',$,'Foreign house',$,$,#12,$,$,.ELEMENT.,$,$,$);
#14=IFCLOCALPLACEMENT(#12,#6);
#15=IFCBUILDINGSTOREY('0storey0000000000000aad',$,'EG',$,$,#14,$,$,.ELEMENT.,0.);
#16=IFCCARTESIANPOINT((0.,0.,2.8));
#17=IFCAXIS2PLACEMENT3D(#16,#4,#5);
#18=IFCLOCALPLACEMENT(#12,#17);
#19=IFCBUILDINGSTOREY('0storey0000000000000aae',$,'OG',$,$,#18,$,$,.ELEMENT.,2.8);
#20=IFCRELAGGREGATES('0agg0000000000000000aaf',$,$,$,#9,(#11));
#21=IFCRELAGGREGATES('0agg0000000000000000aag',$,$,$,#11,(#13));
#22=IFCRELAGGREGATES('0agg0000000000000000aah',$,$,$,#13,(#15,#19));
/* Four exterior walls of a 8 x 6 m house, 0.3 m thick, as rectangle profiles centred on the wall axis, overlapping at the corners. */
#30=IFCCARTESIANPOINT((0.,0.));
#31=IFCDIRECTION((1.,0.));
#32=IFCAXIS2PLACEMENT2D(#30,#31);
#33=IFCRECTANGLEPROFILEDEF(.AREA.,$,#32,8.6,0.3);
#34=IFCRECTANGLEPROFILEDEF(.AREA.,$,#32,0.3,6.6);
/* south wall: centre (4, -0.15) */
#40=IFCCARTESIANPOINT((4.,-0.15,0.));
#41=IFCAXIS2PLACEMENT3D(#40,#4,#5);
#42=IFCLOCALPLACEMENT(#14,#41);
#43=IFCEXTRUDEDAREASOLID(#33,#6,#4,2.8);
#44=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#43));
#45=IFCPRODUCTDEFINITIONSHAPE($,$,(#44));
#46=IFCWALLSTANDARDCASE('0wall000000000000000aai',$,'South',$,$,#42,#45,$,.SOLIDWALL.);
/* north wall: centre (4, 6.15) */
#50=IFCCARTESIANPOINT((4.,6.15,0.));
#51=IFCAXIS2PLACEMENT3D(#50,#4,#5);
#52=IFCLOCALPLACEMENT(#14,#51);
#53=IFCEXTRUDEDAREASOLID(#33,#6,#4,2.8);
#54=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#53));
#55=IFCPRODUCTDEFINITIONSHAPE($,$,(#54));
#56=IFCWALLSTANDARDCASE('0wall000000000000000aaj',$,'North',$,$,#52,#55,$,.SOLIDWALL.);
/* west wall: centre (-0.15, 3) */
#60=IFCCARTESIANPOINT((-0.15,3.,0.));
#61=IFCAXIS2PLACEMENT3D(#60,#4,#5);
#62=IFCLOCALPLACEMENT(#14,#61);
#63=IFCEXTRUDEDAREASOLID(#34,#6,#4,2.8);
#64=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#63));
#65=IFCPRODUCTDEFINITIONSHAPE($,$,(#64));
#66=IFCWALLSTANDARDCASE('0wall000000000000000aak',$,'West',$,$,#62,#65,$,.SOLIDWALL.);
/* east wall: centre (8.15, 3) */
#70=IFCCARTESIANPOINT((8.15,3.,0.));
#71=IFCAXIS2PLACEMENT3D(#70,#4,#5);
#72=IFCLOCALPLACEMENT(#14,#71);
#73=IFCEXTRUDEDAREASOLID(#34,#6,#4,2.8);
#74=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#73));
#75=IFCPRODUCTDEFINITIONSHAPE($,$,(#74));
#76=IFCWALLSTANDARDCASE('0wall000000000000000aal',$,'East',$,$,#72,#75,$,.SOLIDWALL.);
/* interior partition at x = 3 from y = 0 to 6, 0.1 thick */
#80=IFCRECTANGLEPROFILEDEF(.AREA.,$,#32,0.1,6.);
#81=IFCCARTESIANPOINT((3.,3.,0.));
#82=IFCAXIS2PLACEMENT3D(#81,#4,#5);
#83=IFCLOCALPLACEMENT(#14,#82);
#84=IFCEXTRUDEDAREASOLID(#80,#6,#4,2.8);
#85=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#84));
#86=IFCPRODUCTDEFINITIONSHAPE($,$,(#85));
#87=IFCWALL('0wall000000000000000aam',$,'Partition',$,$,#83,#86,$,.PARTITIONING.);
/* a window in the south wall: opening 1.2 wide, 1.4 high, sill 0.9, from x = 2 to 3.2 */
#90=IFCCARTESIANPOINT((2.6,-0.15,0.9));
#91=IFCAXIS2PLACEMENT3D(#90,#4,#5);
#92=IFCRECTANGLEPROFILEDEF(.AREA.,$,#32,1.2,0.4);
#93=IFCEXTRUDEDAREASOLID(#92,#91,#4,1.4);
#94=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#93));
#95=IFCPRODUCTDEFINITIONSHAPE($,$,(#94));
#96=IFCLOCALPLACEMENT(#14,#6);
#97=IFCOPENINGELEMENT('0open000000000000000aan',$,'Opening',$,$,#96,#95,$,.OPENING.);
#98=IFCRELVOIDSELEMENT('0void000000000000000aao',$,$,$,#46,#97);
#99=IFCWINDOW('0win0000000000000000aap',$,'Window',$,$,#96,#95,$,1.4,1.2,.WINDOW.,$,$);
#100=IFCRELFILLSELEMENT('0fill000000000000000aaq',$,$,$,#97,#99);
/* a curved wall on the upper storey that Bauwerk cannot represent */
#110=IFCCARTESIANPOINT((0.,0.,0.));
#111=IFCTRIMMEDCURVE(#112,(IFCPARAMETERVALUE(0.)),(IFCPARAMETERVALUE(180.)),.T.,.PARAMETER.);
#112=IFCCIRCLE(#32,2.);
#113=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#111);
#114=IFCEXTRUDEDAREASOLID(#113,#6,#4,2.8);
#115=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#114));
#116=IFCPRODUCTDEFINITIONSHAPE($,$,(#115));
#117=IFCLOCALPLACEMENT(#18,#6);
#118=IFCWALL('0wall000000000000000aar',$,'Curved',$,$,#117,#116,$,.SOLIDWALL.);
#120=IFCRELCONTAINEDINSPATIALSTRUCTURE('0cont000000000000000aas',$,$,$,(#46,#56,#66,#76,#87,#99),#15);
#121=IFCRELCONTAINEDINSPATIALSTRUCTURE('0cont000000000000000aat',$,$,$,(#118),#19);
/* U-value on the south wall */
#130=IFCPROPERTYSINGLEVALUE('ThermalTransmittance',$,IFCTHERMALTRANSMITTANCEMEASURE(0.9),$);
#131=IFCPROPERTYSET('0pset000000000000000aau',$,'Pset_WallCommon',$,(#130));
#132=IFCRELDEFINESBYPROPERTIES('0rdef000000000000000aav',$,$,$,(#46,#56,#66,#76),#131);
ENDSEC;
END-ISO-10303-21;
